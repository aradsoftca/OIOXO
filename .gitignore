# locally only for the encrypt+push step.
/public/models/

# self-hosted Monaco (copied from node_modules at build; not committed)
/public/monaco/
_hf_token.txt

# Encrypted tool-engine worker bundles (regenerated by scripts/encrypt-workers.mjs
