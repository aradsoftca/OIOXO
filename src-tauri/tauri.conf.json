{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oioxo",
  "version": "0.1.0",
  "identifier": "com.oioxo.app",
  "build": {
    "frontendDist": "../public",
    "devUrl": "https://oioxo.com/"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "oioxo",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "url": "https://oioxo.com/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
